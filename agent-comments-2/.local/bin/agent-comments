#!/usr/bin/env bash
set -euo pipefail

# Resolve real directory regardless of CWD.
target="$(readlink "$0" || echo "$0")"
case "$target" in
  /*) script="$target" ;;
  *)  script="$(cd -P "$(dirname "$0")" && pwd -P)/$target" ;;
esac
dir="$(cd -P "$(dirname "$script")" && pwd -P)"
project_dir="$dir/../.."

# agent-comments has native deps (better-sqlite3), so run with the Node version
# used to install them instead of whatever mise-selected Node the caller's repo uses.
node_bin="${AGENT_COMMENTS_NODE:-$HOME/.local/share/mise/installs/node/24.16.0/bin/node}"

exec "$node_bin" "$project_dir/node_modules/tsx/dist/cli.mjs" "$project_dir/src/index.ts" "$@"
