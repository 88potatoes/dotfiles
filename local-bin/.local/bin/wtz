#!/usr/bin/env node
const { execSync } = require('child_process');
const crypto = require('crypto');
const fs = require('fs');

const commands = ['s', 'k']

const args = process.argv.slice(2);
const command = args[0];
const input = args[1];

if (!commands.includes(command)) {
  console.error("Please provide a valid command: s (switch) or k (kill)");
  process.exit(1);
}

function isGithubPrUrl(url) {
  const prRegex = /^https?:\/\/(www\.)?github\.com\/([^\/]+)\/([^\/]+)\/pull\/(\d+)(\/)?$/;
  return prRegex.test(url);
}

function getShortSessionName(repoName, branchName) {
  const cleanName = `${repoName}.${branchName.replace(/\//g, '-')}`.slice(0, 18);
  const hash = crypto.createHash('md5').update(branchName).digest('hex').slice(0, 6);
  return `${cleanName}-${hash}`;
}

if (command === 's') {
  if (isGithubPrUrl(input)) {
    console.log('yay this is a github pr url')
    let a = JSON.parse(execSync(`gh pr view ${input} --json headRefName,headRepository`).toString())
    let worktreeName = `${a.headRepository.name}.${a.headRefName.replace('/', '-')}`
    console.log("===worktreeName", worktreeName)
    let worktreeDirPath = process.env.HOME + `/Code/${worktreeName}`
    console.log("===worktreeDirPath", worktreeDirPath)
    console.log(a)
    console.log('====');

    // creating worktree
    if (fs.existsSync(worktreeDirPath)) {
      console.log('already exists - skipping wt creation')
    } else {
      console.log('creating wt')
      execSync(`wt switch -b @ -c ${a.headRefName}`).toString()
    }

    // linking worktree to remote
    execSync(`cd ${worktreeDirPath} && git branch --set-upstream-to=origin/${a.headRefName} ${a.headRefName}`)

    // creating zellij session
    const zellijSessionName = getShortSessionName(a.headRepository.name, a.headRefName)
    console.log("===zellijSessionName", zellijSessionName)
    let zellijSessions = execSync('zellij ls -sn').toString().split('\n')
    if (zellijSessions.includes(zellijSessionName)) {
      console.log('already exists - skipping zellij session creation')
    } else {
      console.log('creating zellij session')
      execSync(`cd ${worktreeDirPath} && zellij attach --create-background ${zellijSessionName}`)
    }

    execSync(`zellij action switch-session "${zellijSessionName}"`)

    process.exit(0)
  } else {
    console.log('this is not a github pr url')

    // see if it's a local branch
    const localBranches = execSync('git branch --format="%(refname:short)"')
      .toString()
      .split('\n')
      .map(bn => bn.trim())
      .filter(Boolean);
    console.log('islocalBranches', localBranches.includes(input))
    if (localBranches.includes(input)) {
      console.log('is a local branch')
      let basename = execSync('basename $(pwd)').toString().split('.')[0].trim()
      worktreeName = `${basename}.${input.replace('/', '-')}`
      worktreeDirPath = process.env.HOME + `/Code/${worktreeName}`

      // creating worktree
      if (fs.existsSync(worktreeDirPath)) {
        console.log('already exists - skipping wt creation')
      } else {
        console.log('creating wt')
        execSync(`wt switch ${input}`).toString()
      }

      // creating zellij session
      const zellijSessionName = getShortSessionName(basename, input)
      console.log("===zellijSessionName", zellijSessionName)
      let zellijSessions = execSync('zellij ls -sn').toString().split('\n')
      if (zellijSessions.includes(zellijSessionName)) {
        console.log('already exists - skipping zellij session creation')
      } else {
        console.log('creating zellij session')
        execSync(`cd ${worktreeDirPath} && zellij attach --create-background ${zellijSessionName}`)
      }

      execSync(`zellij action switch-session "${zellijSessionName}"`)
    }
    // see if it's a remote branch

    // const isRemoteBranch = execSync('git branch -r').toString().split('\n').map(bn => bn.trim().replace('origin\/', '')).includes(input)
    // if (isRemoteBranch) {
    //   // if it's not a  worktree, create one
    //   console.log('creating worktree')
    //   execSync(`wt switch -b @ -c ${input}`).toString()
    //   process.exit(0)
    // }

    process.exit(1)
  }
} else if (command === 'k') {
  console.log('killing session (not implemented)')

  // see if it's a local branch
  const localBranches = execSync('git branch --format="%(refname:short)"')
    .toString()
    .split('\n')
    .map(bn => bn.trim())
    .filter(Boolean);

  if (localBranches.includes(input)) {
    let basename = execSync('basename $(pwd)').toString().split('.')[0].trim()
    worktreeName = `${basename}.${input.replace('/', '-')}`
    worktreeDirPath = process.env.HOME + `/Code/${worktreeName}`
    if (fs.existsSync(worktreeDirPath)) {
      execSync(`cd ${worktreeDirPath} && wt remove`)
      const zellijSessionName = getShortSessionName(basename, input)
      execSync(`zellij delete-session ${zellijSessionName} --force`)

    }
  }

}

