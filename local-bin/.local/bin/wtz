#!/usr/bin/env node
const { execSync, spawn, spawnSync } = require('child_process');
const crypto = require('crypto');
const fs = require('fs');
const os = require('os');
const path = require('path');

const commands = ['s', 'k'];

const args = process.argv.slice(2);
const command = args[0];
const input = args[1];

if (!commands.includes(command)) {
  console.error('Please provide a valid command: s (switch) or k (kill)');
  process.exit(1);
}

function shellQuote(value) {
  return `'${String(value).replace(/'/g, `'\\''`)}'`;
}

function safePart(value) {
  return String(value).replace(/[^A-Za-z0-9_.-]+/g, '_').slice(0, 120) || 'unknown';
}

function run(command, options = {}) {
  return execSync(command, { stdio: 'inherit', ...options });
}

function output(command, options = {}) {
  return execSync(command, { encoding: 'utf8', ...options }).trim();
}

function commandExists(cmd) {
  try {
    execSync(`command -v ${shellQuote(cmd)}`, { stdio: 'ignore', shell: '/bin/sh' });
    return true;
  } catch {
    return false;
  }
}

function isGithubPrUrl(url) {
  const prRegex = /^https?:\/\/(www\.)?github\.com\/([^\/]+)\/([^\/]+)\/pull\/(\d+)(\/)?$/;
  return prRegex.test(url);
}

function getShortSessionName(repoName, branchName) {
  const cleanName = `${repoName}.${branchName.replace(/\//g, '-')}`.slice(0, 18);
  const hash = crypto.createHash('md5').update(branchName).digest('hex').slice(0, 6);
  return `${cleanName}-${hash}`;
}

function copyEnvToWorktree(worktreeDirPath) {
  const sourceEnvPath = `${process.cwd()}/.env`;
  const targetEnvPath = `${worktreeDirPath}/.env`;

  if (fs.existsSync(sourceEnvPath) && !fs.existsSync(targetEnvPath)) {
    console.log('copying .env to wt');
    fs.copyFileSync(sourceEnvPath, targetEnvPath);
  }
}

function hasFile(dir, filename) {
  return fs.existsSync(path.join(dir, filename));
}

function pyprojectUsesPoetry(dir) {
  const pyproject = path.join(dir, 'pyproject.toml');
  return fs.existsSync(pyproject) && fs.readFileSync(pyproject, 'utf8').includes('[tool.poetry]');
}

function detectInstallTasks(worktreeDirPath) {
  const tasks = [];

  if (hasFile(worktreeDirPath, 'package.json')) {
    if (hasFile(worktreeDirPath, 'pnpm-lock.yaml')) {
      tasks.push({ label: 'Node packages (pnpm)', cmd: 'pnpm', args: ['install', '--frozen-lockfile'] });
    } else if (hasFile(worktreeDirPath, 'yarn.lock')) {
      const args = hasFile(worktreeDirPath, '.yarnrc.yml') ? ['install', '--immutable'] : ['install', '--frozen-lockfile'];
      tasks.push({ label: 'Node packages (yarn)', cmd: 'yarn', args });
    } else if (hasFile(worktreeDirPath, 'bun.lock') || hasFile(worktreeDirPath, 'bun.lockb')) {
      tasks.push({ label: 'Node packages (bun)', cmd: 'bun', args: ['install', '--frozen-lockfile'] });
    } else if (hasFile(worktreeDirPath, 'package-lock.json') || hasFile(worktreeDirPath, 'npm-shrinkwrap.json')) {
      tasks.push({ label: 'Node packages (npm)', cmd: 'npm', args: ['ci'] });
    } else {
      tasks.push({ label: 'Node packages (npm)', cmd: 'npm', args: ['install'] });
    }
  }

  if (hasFile(worktreeDirPath, 'uv.lock')) {
    tasks.push({ label: 'Python packages (uv)', cmd: 'uv', args: ['sync'] });
  } else if (hasFile(worktreeDirPath, 'poetry.lock') || pyprojectUsesPoetry(worktreeDirPath)) {
    tasks.push({ label: 'Python packages (poetry)', cmd: 'poetry', args: ['install'] });
  } else if (hasFile(worktreeDirPath, 'requirements.txt')) {
    tasks.push({ label: 'Python packages (pip)', cmd: 'python3', args: ['-m', 'pip', 'install', '-r', 'requirements.txt'] });
  } else if (hasFile(worktreeDirPath, 'Pipfile') || hasFile(worktreeDirPath, 'Pipfile.lock')) {
    tasks.push({ label: 'Python packages (pipenv)', cmd: 'pipenv', args: ['install', '--dev'] });
  }

  if (hasFile(worktreeDirPath, 'Cargo.toml')) {
    tasks.push({ label: 'Rust packages', cmd: 'cargo', args: ['fetch'] });
  }

  if (hasFile(worktreeDirPath, 'go.mod')) {
    tasks.push({ label: 'Go packages', cmd: 'go', args: ['mod', 'download'] });
  }

  if (hasFile(worktreeDirPath, 'Gemfile')) {
    tasks.push({ label: 'Ruby packages', cmd: 'bundle', args: ['install'] });
  }

  return tasks;
}

function installPackages(worktreeDirPath) {
  if (process.env.WTZ_INSTALL === '0' || process.env.WTZ_INSTALL === 'false') {
    console.log('WTZ_INSTALL disabled - skipping package install');
    return;
  }

  const tasks = detectInstallTasks(worktreeDirPath);
  if (tasks.length === 0) {
    console.log('no package manifest found - skipping package install');
    return;
  }

  for (const task of tasks) {
    if (!commandExists(task.cmd)) {
      console.log(`${task.cmd} not found - skipping ${task.label}`);
      continue;
    }

    console.log(`installing ${task.label}: ${task.cmd} ${task.args.join(' ')}`);
    const result = spawnSync(task.cmd, task.args, { cwd: worktreeDirPath, stdio: 'inherit' });
    if (result.status !== 0) {
      throw new Error(`${task.label} install failed`);
    }
  }
}

function prepareNewWorktree(worktreeDirPath) {
  copyEnvToWorktree(worktreeDirPath);
  installPackages(worktreeDirPath);
}

function zellijSessions() {
  return output('zellij ls -sn')
    .split('\n')
    .map(session => session.trim())
    .filter(Boolean);
}

function startZellijMruPoller(zellijSessionName) {
  if (!commandExists('zellij-pane-mru-poller')) {
    console.log('zellij-pane-mru-poller not found - skipping MRU poller');
    return;
  }

  const root = path.join(os.tmpdir(), `zellij-mru-poller-${process.getuid?.() ?? 'user'}`);
  fs.mkdirSync(root, { recursive: true });
  const pidPath = path.join(root, `${safePart(zellijSessionName)}.pid`);
  const logPath = path.join(root, `${safePart(zellijSessionName)}.log`);

  if (fs.existsSync(pidPath)) {
    const pid = Number(fs.readFileSync(pidPath, 'utf8'));
    if (pid && !Number.isNaN(pid)) {
      try {
        process.kill(pid, 0);
        console.log('zellij MRU poller already running');
        return;
      } catch {
        fs.rmSync(pidPath, { force: true });
      }
    }
  }

  console.log('starting zellij MRU poller');
  const logFd = fs.openSync(logPath, 'a');
  const child = spawn('zellij-pane-mru-poller', ['--session', zellijSessionName], {
    detached: true,
    stdio: ['ignore', logFd, logFd],
    env: { ...process.env, ZELLIJ_SESSION_NAME: zellijSessionName },
  });
  child.unref();
  fs.writeFileSync(pidPath, `${child.pid}\n`);
}

function ensureZellijSession(worktreeDirPath, repoName, branchName) {
  const zellijSessionName = getShortSessionName(repoName, branchName);
  console.log('===zellijSessionName', zellijSessionName);

  if (zellijSessions().includes(zellijSessionName)) {
    console.log('already exists - skipping zellij session creation');
  } else {
    console.log('creating zellij session');
    run(`cd ${shellQuote(worktreeDirPath)} && zellij attach --create-background ${shellQuote(zellijSessionName)}`);
  }

  startZellijMruPoller(zellijSessionName);
  run(`zellij action switch-session ${shellQuote(zellijSessionName)}`);
}

if (command === 's') {
  if (isGithubPrUrl(input)) {
    console.log('yay this is a github pr url');
    const pr = JSON.parse(output(`gh pr view ${shellQuote(input)} --json headRefName,headRepository`));
    const worktreeName = `${pr.headRepository.name}.${pr.headRefName.replace(/\//g, '-')}`;
    console.log('===worktreeName', worktreeName);
    const worktreeDirPath = process.env.HOME + `/Code/${worktreeName}`;
    console.log('===worktreeDirPath', worktreeDirPath);
    console.log(pr);
    console.log('====');

    if (fs.existsSync(worktreeDirPath)) {
      console.log('already exists - skipping wt creation');
    } else {
      console.log('creating wt');
      run(`wt switch -b @ -c ${shellQuote(pr.headRefName)}`);
      prepareNewWorktree(worktreeDirPath);
    }

    run(`cd ${shellQuote(worktreeDirPath)} && git branch --set-upstream-to=${shellQuote(`origin/${pr.headRefName}`)} ${shellQuote(pr.headRefName)}`);
    ensureZellijSession(worktreeDirPath, pr.headRepository.name, pr.headRefName);
    process.exit(0);
  }

  console.log('this is not a github pr url');

  const localBranches = output('git branch --format="%(refname:short)"')
    .split('\n')
    .map(bn => bn.trim())
    .filter(Boolean);

  console.log('islocalBranches', localBranches.includes(input));
  if (localBranches.includes(input)) {
    console.log('is a local branch');
    const basename = output('basename $(pwd)').split('.')[0].trim();
    const worktreeName = `${basename}.${input.replace(/\//g, '-')}`;
    const worktreeDirPath = process.env.HOME + `/Code/${worktreeName}`;

    if (fs.existsSync(worktreeDirPath)) {
      console.log('already exists - skipping wt creation');
    } else {
      console.log('creating wt');
      run(`wt switch ${shellQuote(input)}`);
      prepareNewWorktree(worktreeDirPath);
    }

    ensureZellijSession(worktreeDirPath, basename, input);
    process.exit(0);
  }

  process.exit(1);
} else if (command === 'k') {
  console.log('killing session');

  const localBranches = output('git branch --format="%(refname:short)"')
    .split('\n')
    .map(bn => bn.trim())
    .filter(Boolean);

  if (localBranches.includes(input)) {
    const basename = output('basename $(pwd)').split('.')[0].trim();
    const worktreeName = `${basename}.${input.replace(/\//g, '-')}`;
    const worktreeDirPath = process.env.HOME + `/Code/${worktreeName}`;
    if (fs.existsSync(worktreeDirPath)) {
      run(`cd ${shellQuote(worktreeDirPath)} && wt remove`);
      const zellijSessionName = getShortSessionName(basename, input);
      run(`zellij delete-session ${shellQuote(zellijSessionName)} --force`);
    }
  }
}
