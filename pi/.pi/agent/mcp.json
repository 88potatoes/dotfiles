{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10,
    "directTools": false
  },
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "figma-api": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "${FIGMA_TOKEN}"
      },
      "lifecycle": "lazy",
      "idleTimeout": 10
    }
  }
}
