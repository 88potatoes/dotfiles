{
  "settings": {
    "toolPrefix": "server",
    "idleTimeout": 10,
    "directTools": false
  },
  "mcpServers": {
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "figma-api": {
      "command": "npx",
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "env": {
        "FIGMA_API_KEY": "!node ~/.pi/agent/get-figma-token.cjs"
      },
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83"],
      "lifecycle": "lazy",
      "idleTimeout": 10
    },
    "datadog": {
      "command": "/Users/eric/.local/bin/datadog_mcp_cli",
      "args": ["--site", "us3"],
      "lifecycle": "lazy"
    },
    "formwork": {
      "type": "http",
      "url": "https://app.openregulatory.com/mcp"
    }
  }
}
